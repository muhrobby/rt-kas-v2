# ===========================================
# RT Kas - Environment Variables
# ===========================================
# SALIN FILE INI KE .env DAN ISI NILAI YANG BENAR
# JANGAN COMMIT FILE .env KE VERSION CONTROL
# ===========================================

# -----------------------------------------
# Database (Supabase PostgreSQL)
# -----------------------------------------
# Connection string Supabase PostgreSQL.
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Atau format lain sesuai Supabase dashboard > Settings > Database > Connection string
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# -----------------------------------------
# Better Auth
# -----------------------------------------
# Secret untuk signing session. WAJIB minimal 32 karakter.
# Generate: openssl rand -base64 32
# JANGAN pakai secret placeholder di production!
BETTER_AUTH_SECRET=your-secret-min-32-chars-here

# URL production. WAJIB sama dengan domain aplikasi Anda.
# Contoh Docker lokal: http://localhost:3030
# Contoh production: https://rt-kas.example.com
# Pastikan menggunakan HTTPS.
BETTER_AUTH_URL=https://your-app.example.com

# URL khusus saat menjalankan docker-compose.
# Ini mencegah Docker lokal ikut memakai BETTER_AUTH_URL dev seperti http://localhost:3000.
DOCKER_APP_URL=http://localhost:3030

# Origin tambahan yang dipercaya Better Auth untuk proteksi CSRF.
# Pisahkan dengan koma jika lebih dari satu.
# Contoh Docker lokal: http://localhost:3030
BETTER_AUTH_TRUSTED_ORIGINS=https://your-app.example.com

# -----------------------------------------
# Seed (Hanya untuk setup awal/admin)
# -----------------------------------------
# Password untuk akun admin awal yang dibuat oleh seed.
# Ini BUKAN secret runtime aplikasi - hanya untuk setup database awal.
# Setelah admin dibuat, password bisa diubah melalui UI atau dihapus dari env.
SEED_ADMIN_PASSWORD=

# -----------------------------------------
# Rate Limiting (Production)
# -----------------------------------------
# Redis untuk distributed rate limiting di production.
# WAJIB untuk deployment multi-instance (Vercel, serverless).
# 
# Tanpa Redis, rate limiting memakai in-memory store yang TIDAK production-grade:
# - State tidak shared antar instance
# - State hilang saat cold start
# - Tidak efektif mencegah brute force/flood
#
# OPSI 1: Upstash Redis (Recommended untuk Vercel)
# Dapatkan dari: https://console.upstash.com
# Atau gunakan Vercel KV: https://vercel.com/docs/storage/vercel-kv
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here

# OPSI 2: Standard Redis (jika tidak pakai Upstash)
# Format: redis://[host]:[port] atau rediss://[host]:[port] untuk TLS
# Contoh: redis://localhost:6379 atau rediss://redis.example.com:6380
# REDIS_URL=redis://localhost:6379


NEXT_PUBLIC_APP_VERSION=1

# -----------------------------------------
# Next.js Telemetry
# -----------------------------------------
# Matikan pengiriman anonymous usage data Next.js ke server eksternal.
# Direkomendasikan untuk aplikasi private/internal.
NEXT_TELEMETRY_DISABLED=1
